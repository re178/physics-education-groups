# ==========================================================
# PHYSICS EDUCATION GROUPS — Environment Variables
# Copy this file to `.env` and fill in real values:
#   cp .env.example .env
# NEVER commit the real `.env` to GitHub.
# ==========================================================

# ----------------------------------------------------------
# SERVER
# ----------------------------------------------------------
PORT=10000
NODE_ENV=development

# ----------------------------------------------------------
# MONGODB ATLAS
# Example:
# mongodb+srv://appuser:YourPassword@cluster0.xxxxx.mongodb.net/physics_groups?retryWrites=true&w=majority
# ----------------------------------------------------------
MONGODB_URI=

# ----------------------------------------------------------
# ADMIN BOOTSTRAP CREDENTIALS
# Used on first admin login only. Password is hashed (scrypt)
# and stored in MongoDB. Afterwards the DB hash is authoritative.
# ----------------------------------------------------------
ADMIN_USERNAME=administrator123
ADMIN_PASSWORD=1234567890

# ----------------------------------------------------------
# SESSION / COOKIE SIGNING SECRET
# Generate with:
#   node -e "console.log(require('crypto').randomBytes(48).toString('hex'))"
# ----------------------------------------------------------
SESSION_SECRET=

# ----------------------------------------------------------
# CORS (comma-separated origins; empty = same-origin only)
# ----------------------------------------------------------
CORS_ORIGIN=

# ----------------------------------------------------------
# OPTIONAL FLAGS
# ----------------------------------------------------------
STORE_IP_HASH=false
ENFORCE_DEVICE_LOCK=true
